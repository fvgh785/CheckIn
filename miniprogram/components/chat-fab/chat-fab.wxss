/* movable-area 全屏覆盖，pointer-events: none 让点击穿透到下层页面 */
.fab-area {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 999;
}

/* movable-view 自身恢复可交互 */
.fab-movable {
  width: 100rpx;
  height: 100rpx;
  pointer-events: auto;
}

/* 按钮本体样式 */
.fab {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #5EBFB7;
  box-shadow: 0 8rpx 24rpx rgba(94, 191, 183, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fab:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 48rpx;
}
