.container {
  padding: 40rpx;
  min-height: 100vh;
  background: #F5FBFA;
}

.page-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #2C4A47;
  display: block;
}

.page-desc {
  font-size: 30rpx;
  color: #6B9E99;
  margin-top: 8rpx;
}

.squad-card {
  background: white;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.04);
}

.squad-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #2C4A47;
  text-align: center;
}

.squad-code {
  text-align: center;
  font-size: 28rpx;
  color: #5EBFB7;
  background: #E8F7F6;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  margin: 16rpx auto;
  display: inline-block;
  width: fit-content;
}

.squad-stats {
  display: flex;
  justify-content: space-around;
  margin: 30rpx 0;
  padding: 24rpx 0;
  border-top: 1rpx solid #D4F1F0;
  border-bottom: 1rpx solid #D4F1F0;
}

.stat-item {
  text-align: center;
}

.stat-val {
  font-size: 48rpx;
  font-weight: 800;
  color: #5EBFB7;
  display: block;
}

.stat-label {
  font-size: 26rpx;
  color: #8BB8B2;
}

.all-check-status {
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #D4F1F0;
  font-size: 30rpx;
  color: #2C4A47;
  margin-bottom: 24rpx;
}

.all-check-status.all-done {
  background: #D4F1F0;
  color: #2C4A47;
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.member-row {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #F0FAF9;
  border-radius: 12rpx;
}

.member-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 28rpx;
}

.member-name {
  flex: 1;
  font-size: 30rpx;
  color: #2C4A47;
}

.member-status {
  font-size: 28rpx;
  color: #8BB8B2;
}

.no-squad {
  text-align: center;
  padding: 80rpx 40rpx;
}

.no-squad-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.no-squad-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #2C4A47;
  display: block;
}

.no-squad-sub {
  font-size: 28rpx;
  color: #8BB8B2;
  display: block;
  margin-top: 8rpx;
}

.action-btns {
  display: flex;
  gap: 20rpx;
  justify-content: center;
  margin-top: 40rpx;
}

.action-btn {
  border-radius: 16rpx;
  font-size: 36rpx;
  padding: 20rpx 48rpx;
  border: none;
}

.action-btn.primary {
  background: #5EBFB7;
  color: white;
}

.action-btn.secondary {
  background: #C5EDEB;
  color: #2C4A47;
}

.action-btn.small {
  padding: 16rpx 32rpx;
  margin-top: 0;
}

.member-tip {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #81D8D0;
}

.input-panel {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 20rpx;
}

.input-field {
  flex: 1;
  border: 2rpx solid #A8D5CF;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 36rpx;
  background: #F5FBFA;
}
.input-field:focus {
  border-color: #5EBFB7;
  background: #fff;
}

.loading {
  text-align: center;
  margin-top: 60rpx;
  color: #6B9E99;
}
