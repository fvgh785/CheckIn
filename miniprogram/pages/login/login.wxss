/* 登录页 - 与全局风格统一的浅色主题 */
.login-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #F5FBFA 0%, #F0F9F8 20%, #EBF7F5 60%, #F5FBFA 100%);
  position: relative;
  overflow: hidden;
}

/* 背景光晕装饰 */
.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
}

.bg-circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(94, 191, 183, 0.1), transparent 70%);
  top: -80rpx;
  right: -120rpx;
}

.bg-circle-2 {
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(61, 175, 168, 0.08), transparent 70%);
  bottom: -60rpx;
  left: -80rpx;
}

.bg-circle-3 {
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(129, 216, 208, 0.06), transparent 70%);
  top: 45%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* 主卡片 */
.login-card {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 64rpx 48rpx 56rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.06), 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  position: relative;
  z-index: 1;
  animation: cardFadeIn 0.6s ease-out;
}

@keyframes cardFadeIn {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56rpx;
}

.logo-ring {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(94, 191, 183, 0.1), rgba(61, 175, 168, 0.06));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
  border: 2rpx solid rgba(94, 191, 183, 0.12);
}

.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(94, 191, 183, 0.15), rgba(61, 175, 168, 0.08));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.app-name {
  font-size: 52rpx;
  font-weight: 800;
  color: #2C4A47;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.app-desc {
  font-size: 30rpx;
  color: #6B9E99;
  letter-spacing: 2rpx;
}

/* 登录区域 */
.login-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ========== 统一按钮设计系统 ========== */
/* 主操作按钮（实心渐变） */
.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #5EBFB7, #3DAFA8);
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  border: none;
  padding: 0 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(94, 191, 183, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  white-space: nowrap;
}

.login-btn-icon {
  font-size: 38rpx;
  flex-shrink: 0;
}

.login-btn::after { border: none; }

.login-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(94, 191, 183, 0.25);
}

.login-btn[disabled] {
  background: #C5EDEB;
  color: #8BB8B2;
  box-shadow: none;
  transform: none;
}

/* 跳过按钮（幽灵风格） */
.skip-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 24rpx;
  background: #D4F1F0;
  color: #4A7A75;
  font-size: 32rpx;
  font-weight: 500;
  border: 1rpx solid #C5EDEB;
  padding: 0;
  box-sizing: border-box;
  white-space: nowrap;
}

.skip-btn::after { border: none; }

.skip-btn:active {
  background: #C5EDEB;
  color: #2C4A47;
}

/* 确认按钮（实心渐变） */
.confirm-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #5EBFB7, #3DAFA8);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  box-shadow: 0 8rpx 24rpx rgba(94, 191, 183, 0.3);
  white-space: nowrap;
}

.confirm-btn::after { border: none; }

.confirm-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(94, 191, 183, 0.25);
}

.confirm-btn[disabled] {
  background: #C5EDEB;
  color: #8BB8B2;
  box-shadow: none;
}
/* ========== 按钮设计系统结束 ========== */

.tips {
  display: block;
  margin-top: 36rpx;
  font-size: 28rpx;
  color: #8BB8B2;
  text-align: center;
}

/* 步骤指示器 */
.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  gap: 16rpx;
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #C5EDEB;
  transition: all 0.4s ease;
}

.step-dot.active {
  background: #3DAFA8;
  box-shadow: 0 0 12rpx rgba(61, 175, 168, 0.4);
  width: 20rpx;
  height: 20rpx;
}

.step-line {
  width: 48rpx;
  height: 3rpx;
  background: #C5EDEB;
  border-radius: 2rpx;
}

/* 资料完善区域 */
.profile-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.profile-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #2C4A47;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.profile-desc {
  font-size: 28rpx;
  color: #6B9E99;
  margin-bottom: 48rpx;
}

.input-group {
  width: 100%;
  margin-bottom: 28rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #F5FBFA;
  border-radius: 20rpx;
  border: 1rpx solid #C5EDEB;
  overflow: hidden;
  transition: border-color 0.3s ease;
}

.input-wrapper:focus-within {
  border-color: rgba(94, 191, 183, 0.5);
  box-shadow: 0 0 0 4rpx rgba(94, 191, 183, 0.08);
  background: #ffffff;
}

.input-icon {
  font-size: 36rpx;
  padding: 0 16rpx 0 28rpx;
  flex-shrink: 0;
}

.nickname-input {
  flex: 1;
  height: 92rpx;
  background: transparent;
  padding: 0 20rpx 0 0;
  font-size: 32rpx;
  color: #2C4A47;
  box-sizing: border-box;
}

.nickname-input::placeholder {
  color: #8BB8B2;
}

.input-hint {
  display: block;
  font-size: 24rpx;
  color: #8BB8B2;
  margin-top: 14rpx;
  text-align: center;
}

/* ========== 邮箱绑定 ========== */
.email-section {
  width: 100%;
  margin-bottom: 20rpx;
}

.section-divider {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-divider::before,
.section-divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #C5EDEB;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #8BB8B2;
  flex-shrink: 0;
}

/* 邮箱已绑定展示 */
.email-display {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  background: #E8F7F6;
  border-radius: 20rpx;
  border: 1rpx solid rgba(61, 175, 168, 0.15);
  box-sizing: border-box;
}

.email-display-icon {
  font-size: 32rpx;
}

.email-display-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C4A47;
  letter-spacing: 1rpx;
}

.email-display-check {
  font-size: 22rpx;
  color: #3DAFA8;
  font-weight: 500;
}

.email-bind-form {
  width: 100%;
}

/* 发送验证码按钮 */
.send-code-row {
  width: 100%;
  margin-bottom: 20rpx;
}

.send-code-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 20rpx;
  background: #E8F7F6;
  color: #3DAFA8;
  font-size: 30rpx;
  font-weight: 500;
  border: 1rpx solid rgba(61, 175, 168, 0.2);
  padding: 0;
  box-sizing: border-box;
  white-space: nowrap;
}

.send-code-btn::after { border: none; }

.send-code-btn:active {
  background: #D4F1F0;
}

.send-code-btn[disabled] {
  background: #D4F1F0;
  color: #8BB8B2;
  border-color: #C5EDEB;
}

/* 验证码区域 */
.verify-code-row {
  width: 100%;
}

.verify-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  gap: 20rpx;
}

.countdown-text {
  font-size: 28rpx;
  color: #8BB8B2;
  flex-shrink: 0;
}

.resend-link {
  font-size: 28rpx;
  color: #3DAFA8;
  flex-shrink: 0;
}

.verify-submit-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #5EBFB7, #3DAFA8);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  box-shadow: 0 6rpx 18rpx rgba(61, 175, 168, 0.3);
  white-space: nowrap;
}

.verify-submit-btn::after { border: none; }

.verify-submit-btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.verify-submit-btn[disabled] {
  background: #C5EDEB;
  color: #8BB8B2;
  box-shadow: none;
}

/* 底部按钮组 */
.profile-actions {
  width: 100%;
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
