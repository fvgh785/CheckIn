.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 160rpx 60rpx 120rpx;
  box-sizing: border-box;
  background-color: #f7f9fb;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100rpx;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 48rpx;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 90rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 48rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 800;
  color: #1a1a1a;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.app-desc {
  font-size: 28rpx;
  color: #888;
  letter-spacing: 1rpx;
}

.login-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-btn {
  width: 100%;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  border-radius: 52rpx;
  background: linear-gradient(145deg, #4A90D9 0%, #2563EB 100%);
  color: white;
  font-size: 34rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 16rpx 32rpx rgba(74, 144, 217, 0.35);
  padding: 0;
  margin: 0;
  overflow: hidden;
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
  box-shadow: 0 8rpx 16rpx rgba(74, 144, 217, 0.2);
}

.login-btn[disabled] {
  background: #e2e8f0;
  color: #94a3b8;
  box-shadow: none;
  transform: none;
}

.tips {
  display: block;
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #aab2bd;
  text-align: center;
}
