<view class="login-container">
  <view class="logo-section">
    <view class="logo">
      <text>📅</text>
    </view>
    <text class="app-name">每日打卡</text>
    <text class="app-desc">记录每一天，成就更好的自己</text>
  </view>

  <!-- 未登录状态：显示登录按钮 -->
  <view class="login-section" wx:if="{{!loggedIn}}">
    <button class="login-btn" bindtap="handleLogin" loading="{{loading}}" disabled="{{loading}}">
      微信一键登录
    </button>
    <text class="tips">登录后即可同步您的打卡数据</text>
  </view>

  <!-- 已登录状态：显示资料完善 -->
  <view class="profile-section" wx:if="{{loggedIn}}">
    <text class="profile-title">完善资料</text>
    <text class="profile-desc">完善以下信息，方便管理员联系</text>

    <!-- 昵称输入 -->
    <view class="input-group">
      <text class="input-label">昵称</text>
      <input
        class="nickname-input"
        type="nickname"
        placeholder="请输入昵称"
        value="{{nickname}}"
        bindinput="onNicknameInput"
        maxlength="20"
      />
    </view>

    <!-- 手机号按钮 -->
    <view class="input-group">
      <text class="input-label">手机号</text>
      <button
        class="phone-btn"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
        disabled="{{gettingPhone}}"
      >
        {{phone || '点击获取手机号'}}
      </button>
    </view>

    <view class="profile-actions">
      <button class="skip-btn" bindtap="handleSkipProfile">跳过</button>
      <button class="confirm-btn" bindtap="handleConfirmProfile" loading="{{saving}}" disabled="{{saving}}">
        完成
      </button>
    </view>
  </view>
</view>
