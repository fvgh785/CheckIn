.container {
  padding: 40rpx;
  min-height: 100vh;
  background: #f8f9fa;
}

.page-header { text-align: center; margin-bottom: 36rpx; }
.page-title { font-size: 44rpx; font-weight: 800; color: #1a1a1a; display: block; }
.page-desc { font-size: 26rpx; color: #888; margin-top: 8rpx; }

.wish-list { display: flex; flex-direction: column; gap: 20rpx; }

.wish-card {
  display: flex; align-items: center; background: white;
  border-radius: 20rpx; padding: 28rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
}
.wish-card.achieved { background: linear-gradient(135deg, #ecfdf5, white); border: 2rpx solid #6ee7b7; }

.wish-progress-ring { margin-right: 24rpx; }
.ring-bg {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: conic-gradient(#3b82f6 calc(var(--pct) * 1%), #e5e7eb 0);
  display: flex; align-items: center; justify-content: center; position: relative;
}
.ring-bg::after {
  content: ''; width: 80rpx; height: 80rpx; border-radius: 50%;
  background: white; position: absolute;
}
.ring-text { font-size: 24rpx; font-weight: 700; color: #3b82f6; z-index: 1; }

.wish-info { flex: 1; }
.wish-content { font-size: 30rpx; color: #1a1a1a; font-weight: 600; display: block; margin-bottom: 8rpx; }
.wish-progress { font-size: 24rpx; color: #6b7280; }
.wish-done { font-size: 26rpx; color: #059669; font-weight: 600; display: block; margin-top: 4rpx; }

.empty { text-align: center; padding: 80rpx 40rpx; }
.empty-emoji { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.empty-text { font-size: 30rpx; color: #374151; font-weight: 500; display: block; }
.empty-sub { font-size: 24rpx; color: #9ca3af; display: block; margin-top: 8rpx; }

.create-btn {
  width: 100%; margin-top: 40rpx; background: #3b82f6; color: white;
  border-radius: 16rpx; font-size: 30rpx; padding: 24rpx; border: none;
}

.create-panel { margin-top: 30rpx; background: white; border-radius: 20rpx; padding: 32rpx; }
.input-field { border: 2rpx solid #e5e7eb; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; }
.days-picker { margin: 20rpx 0; display: flex; align-items: center; }
.days-label { font-size: 26rpx; color: #374151; margin-right: 16rpx; }
slider { flex: 1; }

.submit-btn { background: #10b981; color: white; border-radius: 12rpx; font-size: 28rpx; border: none; }
.loading { text-align: center; margin-top: 60rpx; color: #999; }
