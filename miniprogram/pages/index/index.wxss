.container {
  padding: 30rpx 40rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #F5FBFA;
  display: flex;
  flex-direction: column;
}

/* ========== 宠物区域 ========== */
.pet-section {
  margin-bottom: 24rpx;
}

.pet-card {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.04);
}

.pet-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #D4F1F0, #C5EDEB);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  transition: all 0.3s;
}

.pet-avatar.happy {
  background: linear-gradient(135deg, #B8E8E3, #81D8D0);
  animation: petBounce 0.6s ease;
}

.pet-avatar.sick {
  background: linear-gradient(135deg, #fee2e2, #fca5a5);
  animation: petShake 0.5s ease infinite;
}

@keyframes petBounce {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

@keyframes petShake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-4rpx); }
  75% { transform: translateX(4rpx); }
}

.pet-emoji {
  font-size: 64rpx;
}

.pet-info {
  flex: 1;
  min-width: 0;
}

.pet-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C4A47;
  margin-bottom: 12rpx;
}

.pet-stage {
  font-size: 26rpx;
  color: #4A7A75;
  font-weight: 400;
  margin-left: 8rpx;
  background: #E8F7F6;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.pet-bars {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.bar-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.bar-label {
  font-size: 26rpx;
  width: 100rpx;
  color: #4A7A75;
}

.bar-bg {
  flex: 1;
  height: 12rpx;
  background: #D4F1F0;
  border-radius: 6rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.bar-fill.mood {
  background: linear-gradient(90deg, #81D8D0, #5EBFB7);
}

.bar-fill.hunger {
  background: linear-gradient(90deg, #5EBFB7, #3DAFA8);
}

.bar-val {
  font-size: 26rpx;
  color: #8BB8B2;
  width: 60rpx;
  text-align: right;
}

.pet-sick-tip {
  font-size: 26rpx;
  color: #ef4444;
  margin-top: 8rpx;
}

/* 非会员引导条 */
.pet-teaser {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #D4F1F0, #C5EDEB);
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 24rpx;
}

.teaser-emoji {
  font-size: 44rpx;
  margin-right: 12rpx;
}

.teaser-text {
  font-size: 30rpx;
  color: #2C4A47;
  font-weight: 500;
}

/* ========== 标题区 ========== */
.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 50rpx;
  font-weight: 800;
  color: #2C4A47;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.date {
  font-size: 30rpx;
  color: #6B9E99;
  font-family: sans-serif;
}

.checkin-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 44rpx;
}

.checkin-btn {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #5EBFB7 0%, #3DAFA8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 40rpx rgba(61, 175, 168, 0.35), 0 4rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  z-index: 1;
}

.checkin-btn:active {
  transform: scale(0.94);
  box-shadow: 0 10rpx 20rpx rgba(61, 175, 168, 0.25);
}

.checkin-btn.checked {
  background: linear-gradient(145deg, #3DAFA8 0%, #2A9D95 100%);
  box-shadow: 0 20rpx 40rpx rgba(42, 157, 149, 0.35), 0 4rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-text {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  z-index: 2;
}

.login-tip {
  margin-top: 36rpx;
  padding: 8rpx 24rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 20rpx;
  color: #6B9E99;
  font-size: 28rpx;
}

/* 现代化数据面板 */
.data-panel {
  background: white;
  border-radius: 32rpx;
  padding: 48rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.04);
}

.data-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.data-item.blur {
  opacity: 0.5;
  filter: blur(2px);
  transition: all 0.3s;
}

.data-value {
  font-size: 64rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #5EBFB7 0%, #81D8D0 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  line-height: 1.2;
  font-family: sans-serif;
}

.data-label {
  font-size: 28rpx;
  color: #8BB8B2;
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}

.divider {
  width: 2rpx;
  height: 60rpx;
  background-image: linear-gradient(to bottom, transparent 0%, #C5EDEB 50%, transparent 100%);
  margin: 0 20rpx;
}

/* 补签卡入口条 */
.makeup-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 32rpx 0;
  padding: 16rpx 0;
  cursor: pointer;
}

.makeup-bar-empty {
  opacity: 0.6;
}

.makeup-text {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #4A7A75;
  background: #E8F7F6;
  padding: 10rpx 28rpx;
  border-radius: 24rpx;
  transition: all 0.2s;
}

.makeup-bar:active .makeup-text {
  background: #D4F1F0;
  transform: scale(0.97);
}

.makeup-icon {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #5EBFB7;
  flex-shrink: 0;
  box-shadow: 0 0 0 4rpx rgba(94, 191, 183, 0.2);
}

.makeup-arrow {
  font-size: 36rpx;
  color: #5EBFB7;
  margin-left: 8rpx;
  font-weight: 700;
}

/* ========== 补签卡日历弹窗 ========== */
.calendar-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.calendar-modal {
  width: 630rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx 32rpx 32rpx;
  position: relative;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.12);
}

.cal-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #8BB8B2;
  z-index: 1;
}

/* 月份导航 */
.cal-nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
  padding: 0 8rpx;
}

.cal-nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #5EBFB7;
  border-radius: 50%;
  background: #F0FAF9;
  transition: all 0.2s;
}

.cal-nav-btn:active {
  background: #D4F1F0;
  transform: scale(0.92);
}

.cal-nav-disabled {
  opacity: 0.3;
  pointer-events: none;
}

.cal-month-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C4A47;
  letter-spacing: 1rpx;
}

/* 星期标题 */
.cal-weekdays {
  display: flex;
  margin-bottom: 12rpx;
}

.cal-weekday {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #8BB8B2;
  font-weight: 500;
  padding: 8rpx 0;
}

/* 日期网格 */
.cal-days-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-day-cell {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 16rpx;
  transition: all 0.15s;
  margin-bottom: 2rpx;
}

.cal-day-pad {
  opacity: 0;
  pointer-events: none;
}

.cal-day-normal {
  color: #2C4A47;
}

.cal-day-num {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
}

/* 当天 */
.cal-day-today {
  color: #5EBFB7;
}

.cal-day-today .cal-day-num {
  font-weight: 800;
}

.cal-day-today::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #5EBFB7;
}

/* 已打卡（绿色背景+勾） */
.cal-day-checked {
  background: linear-gradient(135deg, #D4F1F0, #C5EDEB);
  color: #2C4A47;
}

.cal-mark {
  font-size: 20rpx;
  line-height: 1;
  margin-top: 2rpx;
}

.cal-mark-checked {
  color: #3DAFA8;
  font-weight: 700;
}

/* 已补签（深色背景+回旋标） */
.cal-day-makeup {
  background: linear-gradient(135deg, #B8E8E3, #81D8D0);
  color: #2C4A47;
}

.cal-mark-makeup {
  color: #2A9D95;
  font-weight: 700;
}

/* 可补签（浅灰底色，可点击） */
.cal-day-available {
  color: #6B9E99;
  background: #F5FBFA;
  border: 2rpx dashed #C5EDEB;
}

.cal-day-available:active {
  background: #D4F1F0;
  border-color: #5EBFB7;
  transform: scale(0.93);
}

/* 未来日期（灰显，不可点击） */
.cal-day-future {
  color: #C5D4D2;
  pointer-events: none;
}

/* 图例 */
.cal-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #E8F7F6;
}

.cal-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #6B9E99;
}

.cal-legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.cal-dot-checked {
  background: #C5EDEB;
  border: 2rpx solid #3DAFA8;
}

.cal-dot-makeup {
  background: #81D8D0;
  border: 2rpx solid #2A9D95;
}

.cal-dot-avail {
  background: #F5FBFA;
  border: 2rpx dashed #C5EDEB;
}

/* 底部提示 */
.cal-bottom-info {
  margin-top: 20rpx;
  text-align: center;
}

.cal-remain-tip {
  font-size: 26rpx;
  color: #4A7A75;
}

.cal-no-remain {
  color: #8BB8B2;
}

.loading {
  text-align: center;
  margin-top: 60rpx;
  color: #6B9E99;
  font-size: 30rpx;
}