.container {
  padding: 30rpx 40rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #f8f9fa;
  display: flex;
  flex-direction: column;
}

/* ========== 宠物区域 ========== */
.pet-section {
  margin-bottom: 24rpx;
}

.pet-card {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.04);
}

.pet-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  transition: all 0.3s;
}

.pet-avatar.happy {
  background: linear-gradient(135deg, #d1fae5, #6ee7b7);
  animation: petBounce 0.6s ease;
}

.pet-avatar.sick {
  background: linear-gradient(135deg, #fee2e2, #fca5a5);
  animation: petShake 0.5s ease infinite;
}

@keyframes petBounce {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

@keyframes petShake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-4rpx); }
  75% { transform: translateX(4rpx); }
}

.pet-emoji {
  font-size: 64rpx;
}

.pet-info {
  flex: 1;
  min-width: 0;
}

.pet-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.pet-stage {
  font-size: 22rpx;
  color: #6b7280;
  font-weight: 400;
  margin-left: 8rpx;
  background: #f3f4f6;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.pet-bars {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.bar-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.bar-label {
  font-size: 22rpx;
  width: 80rpx;
  color: #6b7280;
}

.bar-bg {
  flex: 1;
  height: 12rpx;
  background: #e5e7eb;
  border-radius: 6rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.bar-fill.mood {
  background: linear-gradient(90deg, #fbbf24, #f59e0b);
}

.bar-fill.hunger {
  background: linear-gradient(90deg, #34d399, #10b981);
}

.bar-val {
  font-size: 22rpx;
  color: #9ca3af;
  width: 40rpx;
  text-align: right;
}

.pet-sick-tip {
  font-size: 22rpx;
  color: #ef4444;
  margin-top: 8rpx;
}

/* 非会员引导条 */
.pet-teaser {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 24rpx;
}

.teaser-emoji {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.teaser-text {
  font-size: 26rpx;
  color: #92400e;
  font-weight: 500;
}

/* ========== 标题区 ========== */
.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 50rpx;
  font-weight: 800;
  color: #1a1a1a;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.date {
  font-size: 26rpx;
  color: #888;
  font-family: sans-serif;
}

.checkin-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 100rpx;
}

.checkin-btn {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #3b82f6 0%, #1d4ed8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 40rpx rgba(29, 78, 216, 0.35), 0 4rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  z-index: 1;
}

.checkin-btn:active {
  transform: scale(0.94);
  box-shadow: 0 10rpx 20rpx rgba(29, 78, 216, 0.25);
}

.checkin-btn.checked {
  background: linear-gradient(145deg, #10b981 0%, #047857 100%);
  box-shadow: 0 20rpx 40rpx rgba(4, 120, 87, 0.35), 0 4rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-text {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  z-index: 2;
}

.login-tip {
  margin-top: 36rpx;
  padding: 8rpx 24rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 20rpx;
  color: #999;
  font-size: 24rpx;
}

/* 现代化数据面板 */
.data-panel {
  background: white;
  border-radius: 32rpx;
  padding: 48rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.04);
}

.data-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.data-item.blur {
  opacity: 0.5;
  filter: blur(2px);
  transition: all 0.3s;
}

.data-value {
  font-size: 64rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #2563eb 0%, #60a5fa 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  line-height: 1.2;
  font-family: sans-serif;
}

.data-label {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}

.divider {
  width: 2rpx;
  height: 60rpx;
  background-image: linear-gradient(to bottom, transparent 0%, #e5e7eb 50%, transparent 100%);
  margin: 0 20rpx;
}

/* 补签卡信息条 */
.makeup-bar {
  text-align: center;
  margin: 20rpx 0;
}

.makeup-text {
  font-size: 24rpx;
  color: #6b7280;
  background: #f3f4f6;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

.loading {
  text-align: center;
  margin-top: 60rpx;
  color: #999;
  font-size: 26rpx;
}