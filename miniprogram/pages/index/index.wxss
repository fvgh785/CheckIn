.container {
  padding: 30rpx 40rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #F5FBFA;
  display: flex;
  flex-direction: column;
}

/* ========== 宠物区域 ========== */
.pet-section {
  margin-bottom: 24rpx;
}

.pet-card {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.04);
}

.pet-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #D4F1F0, #C5EDEB);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  transition: all 0.3s;
}

.pet-avatar.happy {
  background: linear-gradient(135deg, #B8E8E3, #81D8D0);
  animation: petBounce 0.6s ease;
}

.pet-avatar.sick {
  background: linear-gradient(135deg, #fee2e2, #fca5a5);
  animation: petShake 0.5s ease infinite;
}

@keyframes petBounce {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

@keyframes petShake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-4rpx); }
  75% { transform: translateX(4rpx); }
}

.pet-emoji {
  font-size: 64rpx;
}

.pet-info {
  flex: 1;
  min-width: 0;
}

.pet-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C4A47;
  margin-bottom: 12rpx;
}

.pet-stage {
  font-size: 26rpx;
  color: #4A7A75;
  font-weight: 400;
  margin-left: 8rpx;
  background: #E8F7F6;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.pet-bars {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.bar-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.bar-label {
  font-size: 26rpx;
  width: 100rpx;
  color: #4A7A75;
}

.bar-bg {
  flex: 1;
  height: 12rpx;
  background: #D4F1F0;
  border-radius: 6rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.bar-fill.mood {
  background: linear-gradient(90deg, #81D8D0, #5EBFB7);
}

.bar-fill.hunger {
  background: linear-gradient(90deg, #5EBFB7, #3DAFA8);
}

.bar-val {
  font-size: 26rpx;
  color: #8BB8B2;
  width: 60rpx;
  text-align: right;
}

.pet-sick-tip {
  font-size: 26rpx;
  color: #ef4444;
  margin-top: 8rpx;
}

/* 非会员引导条 */
.pet-teaser {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #D4F1F0, #C5EDEB);
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 24rpx;
}

.teaser-emoji {
  font-size: 44rpx;
  margin-right: 12rpx;
}

.teaser-text {
  font-size: 30rpx;
  color: #2C4A47;
  font-weight: 500;
}

/* ========== 标题区 ========== */
.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 50rpx;
  font-weight: 800;
  color: #2C4A47;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.date {
  font-size: 30rpx;
  color: #6B9E99;
  font-family: sans-serif;
}

.checkin-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 44rpx;
}

.checkin-btn {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #5EBFB7 0%, #3DAFA8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 40rpx rgba(61, 175, 168, 0.35), 0 4rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  z-index: 1;
}

.checkin-btn:active {
  transform: scale(0.94);
  box-shadow: 0 10rpx 20rpx rgba(61, 175, 168, 0.25);
}

.checkin-btn.checked {
  background: linear-gradient(145deg, #3DAFA8 0%, #2A9D95 100%);
  box-shadow: 0 20rpx 40rpx rgba(42, 157, 149, 0.35), 0 4rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-text {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  z-index: 2;
}

.login-tip {
  margin-top: 36rpx;
  padding: 8rpx 24rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 20rpx;
  color: #6B9E99;
  font-size: 28rpx;
}

/* 现代化数据面板 */
.data-panel {
  background: white;
  border-radius: 32rpx;
  padding: 48rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.04);
}

.data-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.data-item.blur {
  opacity: 0.5;
  filter: blur(2px);
  transition: all 0.3s;
}

.data-value {
  font-size: 64rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #5EBFB7 0%, #81D8D0 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  line-height: 1.2;
  font-family: sans-serif;
}

.data-label {
  font-size: 28rpx;
  color: #8BB8B2;
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}

.divider {
  width: 2rpx;
  height: 60rpx;
  background-image: linear-gradient(to bottom, transparent 0%, #C5EDEB 50%, transparent 100%);
  margin: 0 20rpx;
}

/* 补签卡信息条 */
.makeup-picker {
  margin: 32rpx 0;
}

.makeup-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.makeup-bar-empty {
  margin: 32rpx 0;
}

.makeup-text {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #4A7A75;
  background: #E8F7F6;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

.makeup-icon {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #5EBFB7;
  flex-shrink: 0;
  box-shadow: 0 0 0 4rpx rgba(94, 191, 183, 0.2);
}

.makeup-arrow {
  font-size: 36rpx;
  color: #5EBFB7;
  margin-left: 8rpx;
  font-weight: 700;
}

.loading {
  text-align: center;
  margin-top: 60rpx;
  color: #6B9E99;
  font-size: 30rpx;
}