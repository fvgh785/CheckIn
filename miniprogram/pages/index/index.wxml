<view class="container">
  <!-- 宠物展示区（会员可见） -->
  <view wx:if="{{isMember && pet}}" class="pet-section">
    <view class="pet-card">
      <view class="pet-avatar {{pet.is_sick ? 'sick' : ''}} {{hasChecked ? 'happy' : ''}}">
        <text class="pet-emoji">{{pet.stage == 1 ? '🥚' : pet.stage == 2 ? (pet.pet_type == 'dog' ? '🐶' : pet.pet_type == 'bunny' ? '🐰' : pet.pet_type == 'panda' ? '🐼' : '🐱') : pet.stage == 3 ? (pet.pet_type == 'dog' ? '🐕' : pet.pet_type == 'bunny' ? '🐇' : pet.pet_type == 'panda' ? '🧸' : '😺') : (pet.pet_type == 'dog' ? '🦮' : pet.pet_type == 'bunny' ? '🐰✨' : pet.pet_type == 'panda' ? '🐼👑' : '🐱‍👤')}}</text>
      </view>
      <view class="pet-info">
        <view class="pet-name">{{pet.pet_name}} <text class="pet-stage">Lv.{{pet.stage}} {{pet.stage_name}}</text></view>
        <view class="pet-bars">
          <view class="bar-row">
            <text class="bar-label">❤️心情</text>
            <view class="bar-bg"><view class="bar-fill mood" style="width: {{pet.mood}}%"></view></view>
            <text class="bar-val">{{pet.mood}}</text>
          </view>
          <view class="bar-row">
            <text class="bar-label">🍖饱腹</text>
            <view class="bar-bg"><view class="bar-fill hunger" style="width: {{pet.hunger}}%"></view></view>
            <text class="bar-val">{{pet.hunger}}</text>
          </view>
        </view>
        <view wx:if="{{pet.is_sick}}" class="pet-sick-tip">😷 宠物生病了，连续打卡3天可恢复</view>
      </view>
    </view>
  </view>

  <!-- 非会员宠物引导 -->
  <view wx:if="{{isLoggedIn && !isMember}}" class="pet-teaser" bindtap="handleGoMembership">
    <text class="teaser-emoji">🥚</text>
    <text class="teaser-text">开通会员，领养你的专属宠物 →</text>
  </view>

  <!-- 日期标题 -->
  <view class="header">
    <text class="title">每日打卡</text>
    <text class="date">{{today}}</text>
  </view>

  <!-- 心情选择区 -->
  <view wx:if="{{isLoggedIn && !hasChecked}}" class="mood-picker">
    <view class="mood-items">
      <view wx:for="{{moodList}}" wx:key="key"
            class="mood-item {{selectedMood === item.key ? 'mood-item-selected' : ''}}"
            style="{{selectedMood === item.key ? 'background:' + item.bgColor + ';border-color:' + item.color : ''}}"
            bindtap="selectMood" data-key="{{item.key}}">
        <text class="mood-emoji">{{item.emoji}}</text>
        <text class="mood-label">{{item.label}}</text>
      </view>
    </view>
    <view class="mood-note-toggle" bindtap="toggleMoodNote">
      <text class="mood-note-toggle-text">{{showMoodNote ? '收起' : '写一句话...'}}</text>
    </view>
    <view wx:if="{{showMoodNote}}" class="mood-note-wrap">
      <input class="mood-note-input" placeholder="今天心情如何？" value="{{moodNote}}"
             bindinput="onMoodNoteInput" maxlength="50" confirm-type="done" />
    </view>
  </view>

  <!-- 打卡按钮 -->
  <view class="checkin-section">
    <view class="checkin-btn {{hasChecked ? 'checked' : ''}}" bindtap="handleCheckIn">
      <text wx:if="{{!hasChecked}}" class="btn-text">打卡</text>
      <text wx:else class="btn-text checked-text">已打卡</text>
    </view>
    <view wx:if="{{!isLoggedIn}}" class="login-tip">
      <text>点击按钮后登录以记录数据</text>
    </view>
  </view>

  <!-- 补签卡入口（会员可见） -->
  <view wx:if="{{isMember && makeupInfo}}" class="makeup-bar {{makeupInfo.remaining > 0 ? '' : 'makeup-bar-empty'}}" bindtap="openCalendar">
    <view class="makeup-text">
      <view class="makeup-icon"></view>
      <text>补签卡：剩余 {{makeupInfo.remaining}}/{{makeupInfo.limit}} 张</text>
    </view>
    <text class="makeup-arrow">›</text>
  </view>

  <!-- 补签卡日历弹窗 -->
  <view wx:if="{{showCalendar}}" class="calendar-overlay" bindtap="closeCalendar">
    <view class="calendar-modal" catchtap="noop">
      <!-- 关闭按钮 -->
      <view class="cal-close" bindtap="closeCalendar">
        <text>✕</text>
      </view>

      <!-- 月份导航 -->
      <view class="cal-nav-row">
        <view class="cal-nav-btn {{calCanPrev ? '' : 'cal-nav-disabled'}}" bindtap="calPrevMonth">
          <text>◀</text>
        </view>
        <text class="cal-month-title">{{calYear}}年{{calMonth}}月</text>
        <view class="cal-nav-btn {{calCanNext ? '' : 'cal-nav-disabled'}}" bindtap="calNextMonth">
          <text>▶</text>
        </view>
      </view>

      <!-- 星期标题 -->
      <view class="cal-weekdays">
        <text wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this" class="cal-weekday">{{item}}</text>
      </view>

      <!-- 日期网格 -->
      <view class="cal-days-grid">
        <view wx:for="{{calDays}}" wx:key="date"
              class="cal-day-cell {{item.cls}} {{item.moodCls}}"
              bindtap="{{item.canTap ? 'calTapDay' : ''}}"
              data-date="{{item.date}}">
          <text class="cal-day-num">{{item.day}}</text>
          <text wx:if="{{item.mood === 'happy'}}" class="cal-mood-emoji">😊</text>
          <text wx:elif="{{item.mood === 'calm'}}" class="cal-mood-emoji">😌</text>
          <text wx:elif="{{item.mood === 'down'}}" class="cal-mood-emoji">😔</text>
          <text wx:elif="{{item.mood === 'annoyed'}}" class="cal-mood-emoji">😤</text>
          <text wx:elif="{{item.mood === 'tired'}}" class="cal-mood-emoji">😴</text>
          <view wx:elif="{{item.isChecked && !item.isMakeup}}" class="cal-mark cal-mark-checked">✓</view>
          <view wx:elif="{{item.isMakeup}}" class="cal-mark cal-mark-makeup">↻</view>
        </view>
      </view>

      <!-- 图例 -->
      <view class="cal-legend">
        <view class="cal-legend-item">
          <view class="cal-legend-dot cal-dot-mood-happy"></view>
          <text>开心</text>
        </view>
        <view class="cal-legend-item">
          <view class="cal-legend-dot cal-dot-mood-calm"></view>
          <text>平静</text>
        </view>
        <view class="cal-legend-item">
          <view class="cal-legend-dot cal-dot-mood-down"></view>
          <text>低落</text>
        </view>
        <view class="cal-legend-item">
          <view class="cal-legend-dot cal-dot-mood-annoyed"></view>
          <text>烦躁</text>
        </view>
        <view class="cal-legend-item">
          <view class="cal-legend-dot cal-dot-mood-tired"></view>
          <text>疲惫</text>
        </view>
      </view>

      <!-- 补签卡余量提示 -->
      <view class="cal-bottom-info">
        <text wx:if="{{calMakeupRemaining > 0}}" class="cal-remain-tip">点击灰色日期使用补签卡（剩余 {{calMakeupRemaining}} 张）</text>
        <text wx:else class="cal-remain-tip cal-no-remain">本月补签卡已用完</text>
      </view>
    </view>
  </view>

  <!-- 数据面板 -->
  <view class="data-panel">
    <view class="data-item {{!isLoggedIn ? 'blur' : ''}}">
      <view class="data-value">{{isLoggedIn ? stats.currentStreak : '--'}}</view>
      <view class="data-label">连续天数</view>
    </view>
    <view class="divider"></view>
    <view class="data-item {{!isLoggedIn ? 'blur' : ''}}">
      <view class="data-value">{{isLoggedIn ? stats.maxStreak : '--'}}</view>
      <view class="data-label">最高记录</view>
    </view>
    <view class="divider"></view>
    <view class="data-item {{!isLoggedIn ? 'blur' : ''}}">
      <view class="data-value">{{isLoggedIn ? stats.totalDays : '--'}}</view>
      <view class="data-label">累计天数</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>
  <chat-fab visible="{{isLoggedIn}}" />
</view>
