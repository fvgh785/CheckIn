.container { padding: 40rpx; min-height: 100vh; background: #f8f9fa; }
.page-header { text-align: center; margin-bottom: 36rpx; }
.page-title { font-size: 44rpx; font-weight: 800; color: #1a1a1a; display: block; }
.page-desc { font-size: 26rpx; color: #888; margin-top: 8rpx; }

.capsule-list { display: flex; flex-direction: column; gap: 20rpx; }

.capsule-card {
  display: flex; align-items: center; background: white;
  border-radius: 20rpx; padding: 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
}
.capsule-card.sealed { border: 2rpx solid #e5e7eb; }
.capsule-card.opened { border: 2rpx solid #fbbf24; background: #fffbeb; }

.capsule-emoji { font-size: 48rpx; margin-right: 20rpx; }
.capsule-info { flex: 1; }
.capsule-preview { font-size: 28rpx; color: #374151; display: block; margin-bottom: 6rpx; }
.capsule-date { font-size: 22rpx; color: #9ca3af; }
.capsule-target { font-size: 22rpx; color: #f59e0b; display: block; }
.capsule-opened-date { font-size: 22rpx; color: #059669; display: block; }

.open-btn {
  background: #8b5cf6; color: white; font-size: 24rpx;
  border-radius: 12rpx; padding: 12rpx 24rpx; border: none;
}

.empty { text-align: center; padding: 80rpx; }
.empty-emoji { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.empty-text { font-size: 30rpx; color: #374151; font-weight: 500; }

.create-btn {
  width: 100%; margin-top: 40rpx; background: #8b5cf6; color: white;
  border-radius: 16rpx; font-size: 30rpx; padding: 24rpx; border: none;
}

.create-panel { margin-top: 30rpx; background: white; border-radius: 20rpx; padding: 32rpx; }
.capsule-textarea { border: 2rpx solid #d1d5db; border-radius: 16rpx; padding: 28rpx; font-size: 32rpx; width: 100%; min-height: 320rpx; box-sizing: border-box; background: #fafbfc; } .capsule-textarea:focus { border-color: #8b5cf6; background: #fff; }
.days-picker { margin: 20rpx 0; }
.days-label { font-size: 26rpx; color: #374151; display: block; margin-bottom: 8rpx; }
.submit-btn { background: #8b5cf6; color: white; border-radius: 12rpx; font-size: 28rpx; border: none; }

.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 999;
}
.modal-content {
  background: white; border-radius: 24rpx; padding: 48rpx 40rpx;
  margin: 0 40rpx; text-align: center; max-height: 70vh; overflow-y: auto;
}
.modal-title { font-size: 36rpx; font-weight: 800; color: #1a1a1a; display: block; margin-bottom: 24rpx; }
.modal-body { font-size: 32rpx; color: #374151; line-height: 1.8; display: block; white-space: pre-wrap; }
.modal-date { font-size: 24rpx; color: #9ca3af; display: block; margin-top: 20rpx; }
.modal-close { margin-top: 30rpx; background: #e5e7eb; border-radius: 12rpx; font-size: 28rpx; border: none; }
.loading { text-align: center; margin-top: 60rpx; color: #999; }
