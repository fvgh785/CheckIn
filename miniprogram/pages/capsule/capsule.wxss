.container { padding: 40rpx; min-height: 100vh; background: #F5FBFA; }
.page-header { text-align: center; margin-bottom: 36rpx; }
.page-title { font-size: 44rpx; font-weight: 800; color: #2C4A47; display: block; }
.page-desc { font-size: 30rpx; color: #6B9E99; margin-top: 8rpx; }

.capsule-list { display: flex; flex-direction: column; gap: 20rpx; }

.capsule-card {
  display: flex; align-items: stretch; background: white;
  border-radius: 20rpx; padding: 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
  gap: 20rpx;
}
.capsule-card.sealed { border: 2rpx solid #C5EDEB; }
.capsule-card.opened { border: 2rpx solid #81D8D0; background: #F5FBFA; }

.capsule-emoji { font-size: 48rpx; flex-shrink: 0; }
.capsule-info { flex: 2; min-width: 0; }
.capsule-preview { font-size: 32rpx; color: #2C4A47; display: block; margin-bottom: 8rpx; word-break: break-all; line-height: 1.5; }
.capsule-date { font-size: 26rpx; color: #8BB8B2; display: block; }
.capsule-target { font-size: 26rpx; color: #5EBFB7; display: block; }
.capsule-opened-date { font-size: 26rpx; color: #3DAFA8; display: block; }

.open-btn {
  flex: 1; min-width: 120rpx;
  background: #5EBFB7; color: white; font-size: 30rpx;
  border-radius: 14rpx; padding: 20rpx 16rpx; border: none; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  line-height: 1.2; align-self: center;
}

.empty { text-align: center; padding: 80rpx; }
.empty-emoji { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.empty-text { font-size: 34rpx; color: #2C4A47; font-weight: 500; }

.create-btn {
  width: 100%; margin-top: 40rpx; background: #5EBFB7; color: white;
  border-radius: 16rpx; font-size: 34rpx; padding: 24rpx; border: none;
}

.create-panel { margin-top: 30rpx; background: white; border-radius: 20rpx; padding: 32rpx; }
.capsule-textarea { border: 2rpx solid #A8D5CF; border-radius: 16rpx; padding: 28rpx; font-size: 36rpx; width: 100%; min-height: 320rpx; box-sizing: border-box; background: #F5FBFA; } .capsule-textarea:focus { border-color: #5EBFB7; background: #fff; }
.days-picker { margin: 24rpx 0; }
.days-label { font-size: 30rpx; color: #2C4A47; display: block; margin-bottom: 16rpx; font-weight: 600; }
.preset-btns { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 20rpx; }
.preset-btn {
  padding: 16rpx 32rpx;
  font-size: 30rpx;
  color: #4A7A75;
  background: #D4F1F0;
  border-radius: 14rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.preset-btn.active {
  color: #3DAFA8;
  background: #E8F7F6;
  border-color: #3DAFA8;
  font-weight: 600;
}
.custom-days-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.custom-label { font-size: 30rpx; color: #4A7A75; flex-shrink: 0; }
.custom-input {
  width: 140rpx;
  height: 64rpx;
  border: 2rpx solid #A8D5CF;
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 32rpx;
  text-align: center;
  background: #F5FBFA;
  box-sizing: border-box;
}
.custom-input:focus { border-color: #5EBFB7; background: #fff; }
.custom-unit { font-size: 30rpx; color: #4A7A75; }
.days-current { font-size: 32rpx; color: #3DAFA8; font-weight: 500; display: block; }
.submit-btn { background: #3DAFA8; color: white; border-radius: 12rpx; font-size: 32rpx; border: none; }

.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 999;
}
.modal-content {
  background: white; border-radius: 24rpx; padding: 48rpx 40rpx;
  margin: 0 40rpx; text-align: center; max-height: 70vh; overflow-y: auto;
}
.modal-title { font-size: 36rpx; font-weight: 800; color: #2C4A47; display: block; margin-bottom: 24rpx; }
.modal-body { font-size: 36rpx; color: #2C4A47; line-height: 1.8; display: block; white-space: pre-wrap; }
.modal-date { font-size: 32rpx; color: #8BB8B2; display: block; margin-top: 20rpx; }
.modal-close { margin-top: 30rpx; background: #C5EDEB; border-radius: 12rpx; font-size: 32rpx; border: none; }
.loading { text-align: center; margin-top: 60rpx; color: #6B9E99; }
