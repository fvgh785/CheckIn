.container {
  padding: 40rpx 40rpx 160rpx;
  min-height: 100vh;
  background: #F5FBFA;
}

.page-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #2C4A47;
  display: block;
}

.page-desc {
  font-size: 30rpx;
  color: #6B9E99;
  margin-top: 8rpx;
}

.insight-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.04);
}

.insight-card.current {
  border-left: 8rpx solid #5EBFB7;
  background: linear-gradient(135deg, #F0FAF9, white);
}

.card-badge {
  font-size: 28rpx;
  color: #5EBFB7;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.insight-content {
  font-size: 34rpx;
  color: #2C4A47;
  line-height: 1.8;
}

.empty-card {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 34rpx;
  color: #2C4A47;
  font-weight: 500;
  display: block;
}

.empty-sub {
  font-size: 28rpx;
  color: #8BB8B2;
  display: block;
  margin-top: 8rpx;
}

.history-section {
  margin-top: 20rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C4A47;
  margin-bottom: 20rpx;
  display: block;
}

.history-date {
  font-size: 28rpx;
  color: #4A7A75;
  margin-bottom: 12rpx;
  display: block;
}

.loading {
  text-align: center;
  margin-top: 60rpx;
  color: #6B9E99;
}

/* 未登录引导 */
.login-guide {
  text-align: center;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.login-guide-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.login-guide-text {
  font-size: 34rpx;
  color: #2C4A47;
  font-weight: 500;
  display: block;
}

/* 生成按钮 */
.generate-btn {
  margin-top: 32rpx;
  background: linear-gradient(135deg, #5EBFB7, #3DAFA8);
  color: white;
  border-radius: 16rpx;
  font-size: 34rpx;
  padding: 24rpx;
  border: none;
  width: 100%;
}

/* 重新生成行 */
.regenerate-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #D4F1F0;
}

.regenerate-btn {
  background: #C5EDEB;
  color: #2C4A47;
  border-radius: 10rpx;
  font-size: 28rpx;
  padding: 12rpx 28rpx;
  border: none;
}

/* 配额提示 */
.quota-tip {
  font-size: 26rpx;
  color: #8BB8B2;
}

.quota-tip.center {
  display: block;
  text-align: center;
  margin-top: 16rpx;
}

.quota-exhausted {
  font-size: 26rpx;
  color: #C5A06A;
}

.quota-exhausted.center {
  display: block;
  text-align: center;
  margin-top: 20rpx;
}

/* 生成中状态 */
.generating-card {
  text-align: center;
  padding: 80rpx 40rpx;
}

.generating-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
  animation: pulse 1.5s ease-in-out infinite;
}

.generating-text {
  font-size: 34rpx;
  color: #4A7A75;
  font-weight: 500;
  display: block;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
