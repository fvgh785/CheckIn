.container {
  padding: 40rpx;
  min-height: 100vh;
  background: #f8f9fa;
}

.page-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1a1a1a;
  display: block;
}

.page-desc {
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
}

.insight-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.04);
}

.insight-card.current {
  border-left: 8rpx solid #8b5cf6;
  background: linear-gradient(135deg, #faf5ff, white);
}

.card-badge {
  font-size: 24rpx;
  color: #8b5cf6;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.insight-content {
  font-size: 30rpx;
  color: #374151;
  line-height: 1.8;
}

.empty-card {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #374151;
  font-weight: 500;
  display: block;
}

.empty-sub {
  font-size: 24rpx;
  color: #9ca3af;
  display: block;
  margin-top: 8rpx;
}

.history-section {
  margin-top: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  display: block;
}

.history-date {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
  display: block;
}

.loading {
  text-align: center;
  margin-top: 60rpx;
  color: #999;
}
