<view class="container">
  <!-- ========== 未登录引导 ========== -->
  <view wx:if="{{!isLoggedIn}}" class="login-guide-card">
    <text class="login-guide-emoji">🔐</text>
    <text class="login-guide-title">请先登录</text>
    <text class="login-guide-desc">登录后可编辑个人资料、管理会员等</text>
    <button class="login-guide-btn" bindtap="goLogin">去登录</button>
  </view>

  <!-- ========== 已登录内容 ========== -->
  <block wx:else>
  <!-- ========== 用户信息卡片 ========== -->
  <view class="info-card">
    <view class="info-avatar">
      <text class="info-avatar-emoji">{{isMember ? '🌟' : '🌱'}}</text>
    </view>
    <view class="info-detail">
      <!-- 昵称行 -->
      <view class="info-row">
        <text class="info-label">昵称</text>
        <view wx:if="{{!showNicknameEdit}}" class="info-value-row">
          <text class="info-value">{{nickname || '未设置'}}</text>
          <text class="info-edit-tag" bindtap="toggleNicknameEdit">编辑</text>
        </view>
        <view wx:else class="info-edit-inline">
          <input class="info-edit-input" placeholder="请输入昵称" maxlength="20" value="{{nicknameInput}}" bindinput="onNicknameInput" />
          <text class="info-edit-confirm" bindtap="handleSaveNickname">保存</text>
          <text class="info-edit-cancel" bindtap="toggleNicknameEdit">取消</text>
        </view>
      </view>
      <!-- 邮箱行 -->
      <view class="info-row {{showRebind ? 'email-editing' : ''}}">
        <text class="info-label {{showRebind ? 'email-label-top' : ''}}">邮箱</text>
        <!-- 已绑定 + 非换绑模式 -->
        <view wx:if="{{emailBound && !showRebind}}" class="info-value-row">
          <text class="info-value email-value">{{email}}</text>
          <text class="info-edit-tag" bindtap="toggleRebind">换绑</text>
        </view>
        <!-- 未绑定 -->
        <view wx:elif="{{!emailBound && !showRebind}}" class="info-value-row">
          <text class="info-value placeholder">未绑定</text>
          <text class="info-edit-tag highlight" bindtap="toggleRebind">绑定</text>
        </view>
        <!-- 换绑/绑定模式 -->
        <view wx:else class="email-form">
          <!-- 输入 + 发送按钮 -->
          <view class="email-input-row">
            <input class="email-input" type="text" placeholder="请输入邮箱地址" value="{{rebindEmail}}" bindinput="onRebindEmailInput" maxlength="50" disabled="{{emailSent}}" />
            <text wx:if="{{!emailSent}}" class="email-btn" bindtap="handleSendEmailCode">发送验证码</text>
          </view>
          <!-- 验证码行 -->
          <view wx:if="{{emailSent}}" class="email-code-row">
            <input class="email-input email-code-input" type="number" placeholder="6位验证码" value="{{emailCode}}" bindinput="onEmailCodeInput" maxlength="6" />
            <block wx:if="{{countdown > 0}}">
              <text class="email-countdown">{{countdown}}s</text>
            </block>
            <block wx:else>
              <text class="email-resend" bindtap="handleSendEmailCode">重发验证码</text>
            </block>
          </view>
          <!-- 底部操作 -->
          <view class="email-bottom">
            <text class="email-cancel" bindtap="toggleRebind">取消</text>
            <text wx:if="{{emailSent}}" class="email-btn primary" bindtap="handleBindEmail">确认绑定</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 会员状态卡片 ========== -->
  <view class="member-card {{isMember ? 'active' : ''}}">
    <view wx:if="{{isMember && membership}}" class="member-active-area">
      <view class="member-level-badge">
        <text class="member-level-star">✨</text>
        <text class="member-level-text">高级会员</text>
      </view>
      <text class="member-expire">有效期至 {{membership.end_date}}</text>
    </view>
    <view wx:else class="member-inactive-area">
      <text class="member-inactive-title">开通会员，解锁更多精彩</text>
      <view class="member-feature-row">
        <text class="member-feature">🐾 宠物养成</text>
        <text class="member-feature">👥 打卡小队</text>
        <text class="member-feature">📊 智能周报</text>
        <text class="member-feature">⭐ 心愿清单</text>
        <text class="member-feature">⏳ 时光胶囊</text>
      </view>
    </view>
  </view>

  <!-- ========== 宠物信息（会员可见） ========== -->
  <view wx:if="{{isMember && pet}}" class="pet-section">
    <text class="section-label">我的伙伴</text>
    <view class="pet-card">
      <view class="pet-avatar-area">
        <text class="pet-emoji-big">{{pet.stage == 1 ? '🥚' : pet.stage == 2 ? (pet.pet_type == 'dog' ? '🐶' : pet.pet_type == 'bunny' ? '🐰' : pet.pet_type == 'panda' ? '🐼' : '🐱') : pet.stage == 3 ? (pet.pet_type == 'dog' ? '🐕' : pet.pet_type == 'bunny' ? '🐇' : pet.pet_type == 'panda' ? '🧸' : '😺') : (pet.pet_type == 'dog' ? '🦮' : pet.pet_type == 'bunny' ? '🐰✨' : pet.pet_type == 'panda' ? '🐼👑' : '🐱‍👤')}}</text>
      </view>
      <view class="pet-detail">
        <view class="pet-name-row">
          <text class="pet-display-name">{{pet.pet_name}}</text>
          <text class="pet-stage-tag">{{pet.stage_name}}</text>
          <view class="pet-rename-btn" bindtap="toggleRename">
            <text>✏️</text>
          </view>
        </view>
        <text class="pet-exp-text">经验值 {{pet.exp}}</text>
        <view class="pet-double-bar">
          <view class="pet-bar-item">
            <text class="pet-bar-label">心情</text>
            <view class="pet-bar-track"><view class="pet-bar-fill mood" style="width: {{pet.mood}}%"></view></view>
          </view>
          <view class="pet-bar-item">
            <text class="pet-bar-label">饱腹</text>
            <view class="pet-bar-track"><view class="pet-bar-fill hunger" style="width: {{pet.hunger}}%"></view></view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{showRename}}" class="pet-rename-panel">
      <input class="pet-rename-input" placeholder="给宠物取个新名字" maxlength="10" value="{{petName}}" bindinput="onPetNameInput" />
      <text class="pet-rename-confirm" bindtap="handleRename">确认</text>
    </view>
  </view>

  <!-- ========== 补签卡（会员可见） ========== -->
  <view wx:if="{{isMember && makeupInfo}}" class="makeup-section">
    <text class="section-label">补签卡</text>
    <view class="makeup-card">
      <view class="makeup-progress-row">
        <view class="makeup-bar-track">
          <view class="makeup-bar-fill" style="width: {{makeupInfo.remaining / makeupInfo.limit * 100}}%"></view>
        </view>
        <text class="makeup-count">{{makeupInfo.remaining}}/{{makeupInfo.limit}}</text>
      </view>
      <text class="makeup-hint">每月自动重置额度</text>
    </view>
  </view>

  <!-- ========== 功能入口 ========== -->
  <view class="menu-section">
    <text class="section-label">快捷入口</text>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToCapsule">
        <view class="menu-item-icon">⏳</view>
        <view class="menu-item-text">
          <text class="menu-item-title">时光胶囊</text>
          <text class="menu-item-desc">记录美好，未来开启</text>
        </view>
        <text class="menu-item-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="bottom-space"></view>
  </block>
</view>
