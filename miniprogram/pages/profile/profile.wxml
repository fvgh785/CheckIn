<view class="container">
  <!-- 会员状态卡片 -->
  <view class="member-card {{isMember ? 'active' : ''}}">
    <view wx:if="{{isMember}}" class="member-badge">✨ 会员</view>
    <view wx:else class="member-badge inactive">免费用户</view>

    <view wx:if="{{isMember && membership}}" class="member-detail">
      <text class="member-level">等级：{{membership.level}}</text>
      <text class="member-expire">到期：{{membership.end_date}}</text>
    </view>

    <view wx:if="{{!isMember}}" class="member-upgrade">
      <text class="upgrade-text">开通会员解锁全部功能</text>
      <text class="upgrade-desc">宠物养成 · 打卡小队 · AI周报 · 心愿清单 · 时光胶囊</text>
    </view>
  </view>

  <!-- 宠物信息（会员可见） -->
  <view wx:if="{{isMember && pet}}" class="section">
    <text class="section-title">我的宠物</text>
    <view class="pet-info-card">
      <text class="pet-emoji-large">{{pet.stage == 1 ? '🥚' : pet.stage == 2 ? (pet.pet_type == 'dog' ? '🐶' : pet.pet_type == 'bunny' ? '🐰' : pet.pet_type == 'panda' ? '🐼' : '🐱') : pet.stage == 3 ? (pet.pet_type == 'dog' ? '🐕' : pet.pet_type == 'bunny' ? '🐇' : pet.pet_type == 'panda' ? '🧸' : '😺') : (pet.pet_type == 'dog' ? '🦮' : pet.pet_type == 'bunny' ? '🐰✨' : pet.pet_type == 'panda' ? '🐼👑' : '🐱‍👤')}}</text>
      <view class="pet-detail">
        <text class="pet-name-text">{{pet.pet_name}}</text>
        <text class="pet-stage-text">{{pet.stage_name}} · 经验 {{pet.exp}}</text>
        <text class="pet-rename-link" bindtap="toggleRename">✏️ 改名</text>
      </view>
    </view>

    <view wx:if="{{showRename}}" class="rename-panel">
      <input class="rename-input" placeholder="输入新名字" maxlength="10" value="{{petName}}" bindinput="onPetNameInput" />
      <button class="rename-btn" bindtap="handleRename">确认</button>
    </view>
  </view>

  <!-- 补签卡 -->
  <view wx:if="{{isMember && makeupInfo}}" class="section">
    <text class="section-title">补签卡</text>
    <text class="makeup-info">剩余 {{makeupInfo.remaining}}/{{makeupInfo.limit}} 张（每月重置）</text>
  </view>

  <!-- 功能入口 -->
  <view class="section">
    <text class="section-title">功能入口</text>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToCapsule">
        <text class="menu-icon">⏳</text>
        <text class="menu-text">时光胶囊</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
</view>
