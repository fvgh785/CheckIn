/* 个人中心 - 高大上风格 */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f7ff 0%, #f0edff 20%, #f5f5f7 60%, #fafafa 100%);
  padding-bottom: 40rpx;
}

/* 顶部区域 */
.header-section {
  padding: 80rpx 40rpx 48rpx;
  position: relative;
  overflow: hidden;
}

.header-glow {
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(124, 58, 237, 0.12), transparent 70%);
  pointer-events: none;
}

.page-title {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  color: #1a1a2e;
  letter-spacing: 4rpx;
  line-height: 1.2;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #8b8ba0;
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

/* 会员状态卡片 */
.member-card {
  margin: 0 32rpx 28rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.05), 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.member-card.active {
  background: linear-gradient(135deg, #faf5ff 0%, #ffffff 40%, #fefce8 100%);
  border-color: rgba(245, 158, 11, 0.2);
  box-shadow: 0 12rpx 40rpx rgba(245, 158, 11, 0.08), 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.member-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.badge-icon {
  font-size: 36rpx;
}

.badge-text {
  font-size: 36rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.member-badge.inactive .badge-text {
  background: linear-gradient(135deg, #9ca3af, #6b7280);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.member-detail {
  display: flex;
  justify-content: center;
  gap: 48rpx;
}

.detail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.detail-label {
  font-size: 22rpx;
  color: #9ca3af;
  letter-spacing: 1rpx;
}

.detail-value {
  font-size: 28rpx;
  color: #374151;
  font-weight: 600;
}

/* 会员升级引导 */
.member-upgrade {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding-top: 4rpx;
}

.upgrade-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.feature-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}

.feature-tag {
  font-size: 22rpx;
  color: #7c3aed;
  background: rgba(124, 58, 237, 0.06);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.1);
}

/* 通用 section */
.section {
  margin: 0 32rpx 28rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 18rpx;
  letter-spacing: 1rpx;
}

/* 宠物卡片 */
.pet-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.pet-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(251, 191, 36, 0.2);
}

.pet-emoji {
  font-size: 52rpx;
}

.pet-info {
  flex: 1;
}

.pet-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  margin-bottom: 6rpx;
}

.pet-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pet-stage {
  font-size: 24rpx;
  color: #7c3aed;
  background: rgba(124, 58, 237, 0.06);
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.pet-exp {
  font-size: 22rpx;
  color: #9ca3af;
}

.pet-action {
  padding: 12rpx 20rpx;
  background: rgba(124, 58, 237, 0.06);
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #7c3aed;
  font-weight: 500;
}

.pet-action:active {
  background: rgba(124, 58, 237, 0.12);
}

/* 改名面板 */
.rename-panel {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.rename-input {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 18rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #ffffff;
  color: #1a1a2e;
  box-sizing: border-box;
}

.rename-input:focus {
  border-color: #7c3aed;
  box-shadow: 0 0 0 4rpx rgba(124, 58, 237, 0.08);
}

.rename-btn {
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #7c3aed, #6366f1);
  color: #ffffff;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  padding: 0 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(124, 58, 237, 0.25);
}

.rename-btn::after {
  border: none;
}

/* 补签卡 */
.makeup-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.makeup-progress {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.makeup-bar-bg {
  flex: 1;
  height: 16rpx;
  background: #f3f4f6;
  border-radius: 8rpx;
  overflow: hidden;
}

.makeup-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #7c3aed, #a78bfa);
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.makeup-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #7c3aed;
  min-width: 80rpx;
  text-align: right;
}

.makeup-note {
  font-size: 22rpx;
  color: #9ca3af;
}

/* 功能入口菜单 */
.menu-list {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  transition: background 0.2s ease;
}

.menu-item:active {
  background: rgba(124, 58, 237, 0.04);
}

.menu-item:not(:last-child) {
  border-bottom: 1rpx solid #f8f8fa;
}

.menu-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.08), rgba(99, 102, 241, 0.04));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.menu-icon {
  font-size: 32rpx;
}

.menu-text {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #1a1a2e;
  font-weight: 500;
  margin-right: 16rpx;
}

.menu-desc {
  flex: 1;
  font-size: 22rpx;
  color: #9ca3af;
  text-align: right;
}

.menu-arrow {
  font-size: 36rpx;
  color: #d1d5db;
  margin-left: 8rpx;
}

/* 底部占位 */
.bottom-space {
  height: 60rpx;
}
