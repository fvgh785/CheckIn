/* ============================================
   个人中心 — 蒂芙尼蓝 手帐风格
   配色：#81D8D0 / #5EBFB7 / #3DAFA8
   ============================================ */

/* --- 全局底色 --- */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #F5FBFA 0%, #F0F9F8 8%, #EBF7F5 30%, #F5FBFA 70%, #EEF6F4 100%);
  padding: 48rpx 36rpx 40rpx;
}

/* ========== 用户信息卡片 ========== */
.info-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 32rpx 36rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(94, 191, 183, 0.06),
              0 2rpx 8rpx rgba(94, 191, 183, 0.03);
  border: 1rpx solid rgba(94, 191, 183, 0.08);
}

.info-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D4F1F0, #C5EDEB);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(94, 191, 183, 0.15);
}

.info-avatar-emoji {
  font-size: 44rpx;
}

.info-detail {
  flex: 1;
  min-width: 0;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0;
  min-height: 52rpx;
}

.info-row + .info-row {
  border-top: 1rpx solid rgba(94, 191, 183, 0.08);
  margin-top: 2rpx;
  padding-top: 12rpx;
}

.info-label {
  font-size: 34rpx;
  color: #4A7A75;
  font-weight: 500;
  flex-shrink: 0;
  width: 70rpx;
}

.info-value-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  justify-content: flex-end;
  min-width: 0;
}

.info-value {
  font-size: 34rpx;
  color: #2C4A47;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-value.email-value {
  font-size: 28rpx;
}

.info-value.placeholder {
  color: #8BB8B2;
}

.info-edit-tag {
  font-size: 26rpx;
  color: #5EBFB7;
  background: rgba(94, 191, 183, 0.08);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  border: 1rpx solid rgba(94, 191, 183, 0.15);
}

.info-edit-tag.highlight {
  color: #3DAFA8;
  background: rgba(94, 191, 183, 0.12);
  border-color: rgba(94, 191, 183, 0.25);
}

.info-edit-tag:active {
  opacity: 0.7;
}

/* 昵称/邮箱编辑内联 */
.info-edit-inline {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  justify-content: flex-end;
}

.info-edit-input {
  height: 56rpx;
  border: 2rpx solid #C5EDEB;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 34rpx;
  color: #2C4A47;
  background: #F5FBFA;
  flex: 1;
  box-sizing: border-box;
}

.info-edit-input:focus {
  border-color: #5EBFB7;
  background: #FFFFFF;
}

.info-edit-input.code-input {
  max-width: 180rpx;
}

.info-edit-confirm {
  font-size: 28rpx;
  color: #3DAFA8;
  font-weight: 600;
  flex-shrink: 0;
  padding: 4rpx 0;
}

.info-edit-cancel {
  font-size: 28rpx;
  color: #6B9E99;
  flex-shrink: 0;
  padding: 4rpx 0;
}

.info-edit-confirm:active,
.info-edit-cancel:active {
  opacity: 0.6;
}

/* 邮箱编辑器对齐修正 */
.info-row.email-editing {
  align-items: flex-start;
}

.info-label.email-label-top {
  padding-top: 10rpx;
}

.email-form {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

/* 输入行：邮箱 + 发送按钮 */
.email-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.email-input {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  border: 2rpx solid #C5EDEB;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #2C4A47;
  background: #F5FBFA;
  box-sizing: border-box;
}

.email-input:focus {
  border-color: #5EBFB7;
  background: #FFFFFF;
}

.email-code-input {
  max-width: 190rpx;
}

/* 发送验证码按钮 */
.email-btn {
  flex-shrink: 0;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 22rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #5EBFB7, #3DAFA8);
  border-radius: 14rpx;
  white-space: nowrap;
  text-align: center;
}

.email-btn.primary {
  background: linear-gradient(135deg, #5EBFB7, #3DAFA8);
}

.email-btn:active {
  opacity: 0.85;
}

/* 验证码行 */
.email-code-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.email-countdown {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #6B9E99;
  white-space: nowrap;
}

.email-resend {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #5EBFB7;
  white-space: nowrap;
}

.email-resend:active {
  opacity: 0.7;
}

/* 底部操作行 */
.email-bottom {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
}

.email-cancel {
  font-size: 28rpx;
  color: #8BB8B2;
  padding: 4rpx 0;
}

.email-cancel:active {
  opacity: 0.6;
}

/* ========== 会员状态卡片 ========== */
.member-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(94, 191, 183, 0.06),
              0 2rpx 8rpx rgba(94, 191, 183, 0.03);
  border: 1rpx solid rgba(94, 191, 183, 0.08);
  text-align: center;
}

.member-card.active {
  background: linear-gradient(135deg, #F5FBFA 0%, #F0F9F8 50%, #EBF7F5 100%);
  border-color: rgba(94, 191, 183, 0.2);
  box-shadow: 0 12rpx 44rpx rgba(94, 191, 183, 0.08),
              0 2rpx 8rpx rgba(94, 191, 183, 0.03);
}

.member-active-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.member-level-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.member-level-star {
  font-size: 36rpx;
}

.member-level-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #3DAFA8;
  letter-spacing: 2rpx;
}

.member-expire {
  font-size: 28rpx;
  color: #6B9E99;
}

.member-inactive-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.member-inactive-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2C4A47;
  letter-spacing: 1rpx;
}

.member-feature-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx 18rpx;
}

.member-feature {
  font-size: 28rpx;
  color: #4A7A75;
  background: rgba(94, 191, 183, 0.08);
  padding: 10rpx 22rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(94, 191, 183, 0.1);
}

/* ========== Section 通用标签 ========== */
.section-label {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #3DAFA8;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
  padding-left: 6rpx;
}

/* ========== 宠物卡片 ========== */
.pet-section {
  margin-bottom: 36rpx;
}

.pet-card {
  background: linear-gradient(135deg, #F5FBFA 0%, #F0F9F8 50%, #E8F7F6 100%);
  border-radius: 28rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-shadow: 0 8rpx 32rpx rgba(94, 191, 183, 0.06);
  border: 1rpx solid rgba(94, 191, 183, 0.1);
}

.pet-avatar-area {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D4F1F0, #C5EDEB);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(94, 191, 183, 0.15);
}

.pet-emoji-big {
  font-size: 58rpx;
}

.pet-detail {
  flex: 1;
  min-width: 0;
}

.pet-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.pet-display-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C4A47;
}

.pet-stage-tag {
  font-size: 26rpx;
  color: #3DAFA8;
  background: rgba(94, 191, 183, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.pet-exp-text {
  font-size: 26rpx;
  color: #6B9E99;
  margin-bottom: 12rpx;
  display: block;
}

.pet-double-bar {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.pet-bar-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.pet-bar-label {
  font-size: 26rpx;
  color: #4A7A75;
  width: 80rpx;
  flex-shrink: 0;
}

.pet-bar-track {
  flex: 1;
  height: 10rpx;
  background: #D4F1F0;
  border-radius: 5rpx;
  overflow: hidden;
}

.pet-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.5s ease;
}

.pet-bar-fill.mood {
  background: linear-gradient(90deg, #81D8D0, #5EBFB7);
}

.pet-bar-fill.hunger {
  background: linear-gradient(90deg, #5EBFB7, #3DAFA8);
}

.pet-rename-btn {
  padding: 4rpx 8rpx;
  font-size: 28rpx;
  flex-shrink: 0;
  line-height: 1;
}

.pet-rename-btn:active {
  opacity: 0.6;
}

.pet-rename-panel {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(94, 191, 183, 0.05);
  border: 1rpx solid rgba(94, 191, 183, 0.08);
}

.pet-rename-input {
  flex: 1;
  height: 64rpx;
  border: 2rpx solid #C5EDEB;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #2C4A47;
  background: #F5FBFA;
}

.pet-rename-input:focus {
  border-color: #5EBFB7;
}

.pet-rename-confirm {
  font-size: 34rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #5EBFB7, #3DAFA8);
  padding: 14rpx 28rpx;
  border-radius: 16rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.pet-rename-confirm:active {
  opacity: 0.85;
}

/* ========== 补签卡 ========== */
.makeup-section {
  margin-bottom: 36rpx;
}

.makeup-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(94, 191, 183, 0.05);
  border: 1rpx solid rgba(94, 191, 183, 0.06);
}

.makeup-progress-row {
  display: flex;
  align-items: center;
  gap: 26rpx;
  margin-bottom: 12rpx;
}

.makeup-bar-track {
  flex: 1;
  height: 18rpx;
  background: #D4F1F0;
  border-radius: 9rpx;
  overflow: hidden;
}

.makeup-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #81D8D0, #5EBFB7);
  border-radius: 9rpx;
  transition: width 0.5s ease;
}

.makeup-count {
  font-size: 32rpx;
  font-weight: 700;
  color: #3DAFA8;
  flex-shrink: 0;
}

.makeup-hint {
  font-size: 26rpx;
  color: #6B9E99;
}

/* ========== 功能入口菜单 ========== */
.menu-section {
  margin-bottom: 36rpx;
}

.menu-list {
  background: #FFFFFF;
  border-radius: 26rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(94, 191, 183, 0.05);
  border: 1rpx solid rgba(94, 191, 183, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  gap: 20rpx;
}

.menu-item:active {
  background: rgba(94, 191, 183, 0.05);
}

.menu-item-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(94, 191, 183, 0.1), rgba(61, 175, 168, 0.06));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.menu-item-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.menu-item-title {
  font-size: 32rpx;
  color: #2C4A47;
  font-weight: 500;
}

.menu-item-desc {
  font-size: 26rpx;
  color: #6B9E99;
}

.menu-item-arrow {
  font-size: 40rpx;
  color: #A8D5CF;
  flex-shrink: 0;
}

/* ========== 底部 ========== */
.bottom-space {
  height: 80rpx;
}
