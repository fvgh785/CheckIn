.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5FBFA;
}

/* 未登录引导 */
.login-guide {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.login-emoji {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2C4A47;
  margin-bottom: 12rpx;
}

.login-desc {
  font-size: 28rpx;
  color: #8BB8B2;
  text-align: center;
  margin-bottom: 48rpx;
  line-height: 1.6;
}

.login-btn {
  background: #5EBFB7;
  color: white;
  border: none;
  border-radius: 24rpx;
  padding: 24rpx 80rpx;
  font-size: 32rpx;
}

/* 知识库区域 */
.kb-section {
  background: white;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
}

.kb-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #E8F7F6;
}

.kb-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C4A47;
}

.kb-toggle {
  font-size: 26rpx;
  color: #5EBFB7;
}

.kb-list {
  padding: 8rpx 0;
  max-height: 260rpx;
  overflow-y: auto;
}

.kb-item {
  padding: 16rpx 28rpx;
  border-bottom: 1rpx solid #F0FAF9;
}

.kb-item:last-child {
  border-bottom: none;
}

.kb-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C4A47;
  display: block;
  margin-bottom: 6rpx;
}

.kb-item-summary {
  font-size: 24rpx;
  color: #8BB8B2;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 配额栏 */
.quota-bar {
  padding: 12rpx 28rpx;
  flex-shrink: 0;
}

.quota-text {
  font-size: 24rpx;
  color: #A8D5CF;
}

/* 消息列表 */
.msg-list {
  flex: 1;
  padding: 16rpx 24rpx;
  overflow-y: auto;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx 40rpx;
}

.empty-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2C4A47;
  display: block;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #8BB8B2;
  display: block;
}

/* 快捷问题 */
.quick-asks {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 100rpx 40rpx;
}

.quick-item {
  background: white;
  border: 1rpx solid #C5EDEB;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  text-align: center;
}

.quick-item text {
  font-size: 28rpx;
  color: #5EBFB7;
}

/* 消息行 */
.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.msg-left {
  flex-direction: row;
}

.msg-right {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  background: #E8F7F6;
}

.msg-left .msg-avatar {
  margin-right: 12rpx;
}

.msg-right .msg-avatar {
  margin-left: 12rpx;
}

.msg-bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
}

.bubble-ai {
  background: white;
  color: #2C4A47;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.bubble-user {
  background: #5EBFB7;
  color: white;
  border-top-right-radius: 4rpx;
}

/* rich-text markdown内容样式 */
.bubble-ai rich-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #2C4A47;
  word-break: break-all;
  display: block;
  width: 100%;
}
.load-more {
  text-align: center;
  padding: 20rpx;
}

.load-more text {
  font-size: 24rpx;
  color: #A8D5CF;
}

/* 输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: white;
  border-top: 1rpx solid #E8F7F6;
  flex-shrink: 0;
  gap: 16rpx;
}

.input-field {
  flex: 1;
  background: #F5FBFA;
  border: 1rpx solid #D4F1F0;
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
  font-size: 30rpx;
  color: #2C4A47;
}

.input-field:focus {
  border-color: #5EBFB7;
}

.send-btn {
  background: #5EBFB7;
  color: white;
  border: none;
  border-radius: 24rpx;
  padding: 20rpx 36rpx;
  font-size: 30rpx;
  flex-shrink: 0;
}

.send-btn.disabled {
  background: #C5EDEB;
  color: white;
}

/* 知识库详情弹窗 */
.kb-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.kb-modal {
  width: 86%;
  max-height: 70vh;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
}

.kb-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #E8F7F6;
}

.kb-modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C4A47;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kb-modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.kb-modal-close text {
  font-size: 32rpx;
  color: #8BB8B2;
}

.kb-modal-body {
  padding: 28rpx 32rpx 32rpx;
  max-height: 52vh;
  overflow-y: auto;
  box-sizing: border-box;
}

.kb-modal-content {
  font-size: 30rpx;
  color: #2C4A47;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
  overflow-wrap: break-word;
  width: 100%;
}

.kb-modal-footer {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0FAF9;
}

.kb-modal-category {
  font-size: 24rpx;
  color: #A8D5CF;
}
